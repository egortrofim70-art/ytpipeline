[
  {
    "para_index": 0,
    "text": "Imagina que un día, sin ninguna razón, simplemente dejas de ",
    "from_sec": 0.0,
    "to_sec": 12.639,
    "cues": [
      {
        "fromSec": 0.0,
        "toSec": 2.72,
        "text": "Imagina que un día, sin ninguna razón,"
      },
      {
        "fromSec": 2.84,
        "toSec": 5.04,
        "text": "simplemente dejas de poder dormir."
      },
      {
        "fromSec": 5.36,
        "toSec": 6.32,
        "text": "No una mala noche."
      },
      {
        "fromSec": 6.72,
        "toSec": 7.36,
        "text": "No estrés."
      },
      {
        "fromSec": 7.84,
        "toSec": 10.32,
        "text": "Dejas de dormir para siempre, y en menos"
      },
      {
        "fromSec": 10.4,
        "toSec": 12.64,
        "text": "de dos años, eso te mata."
      }
    ]
  },
  {
    "para_index": 1,
    "text": "Suena a una película de terror, pero es un diagnóstico real.",
    "from_sec": 13.519,
    "to_sec": 25.759,
    "cues": [
      {
        "fromSec": 13.52,
        "toSec": 15.68,
        "text": "Suena a una película de terror, pero es"
      },
      {
        "fromSec": 15.76,
        "toSec": 16.88,
        "text": "un diagnóstico real."
      },
      {
        "fromSec": 17.36,
        "toSec": 20.32,
        "text": "Se llama insomnio familiar fatal, y hoy"
      },
      {
        "fromSec": 20.48,
        "toSec": 22.56,
        "text": "te voy a contar exactamente qué le pasa a"
      },
      {
        "fromSec": 22.64,
        "toSec": 24.56,
        "text": "tu cerebro cuando el sueño desaparece"
      },
      {
        "fromSec": 24.64,
        "toSec": 25.76,
        "text": "para siempre."
      }
    ]
  },
  {
    "para_index": 2,
    "text": "Noche uno. Son las dos de la madrugada y sigues despierto, m",
    "from_sec": 26.238,
    "to_sec": 46.397,
    "cues": [
      {
        "fromSec": 26.24,
        "toSec": 26.96,
        "text": "Noche uno."
      },
      {
        "fromSec": 27.6,
        "toSec": 29.44,
        "text": "Son las dos de la madrugada y sigues"
      },
      {
        "fromSec": 29.52,
        "toSec": 32.0,
        "text": "despierto, mirando el teléfono, esperando"
      },
      {
        "fromSec": 32.04,
        "toSec": 32.96,
        "text": "que el sueño llegue."
      },
      {
        "fromSec": 33.6,
        "toSec": 34.4,
        "text": "Pasa una hora."
      },
      {
        "fromSec": 34.88,
        "toSec": 35.68,
        "text": "Y luego otra."
      },
      {
        "fromSec": 36.32,
        "toSec": 38.0,
        "text": "Te das vueltas en la cama, intentas"
      },
      {
        "fromSec": 38.08,
        "toSec": 38.96,
        "text": "ponerte cómodo."
      },
      {
        "fromSec": 39.36,
        "toSec": 41.52,
        "text": "Agarras la almohada, te tapas la cabeza,"
      },
      {
        "fromSec": 41.56,
        "toSec": 43.6,
        "text": "lo que sea con tal de no ver la hora."
      },
      {
        "fromSec": 44.08,
        "toSec": 45.52,
        "text": "Pero el sueño no llega."
      },
      {
        "fromSec": 45.76,
        "toSec": 46.4,
        "text": "Para nada."
      }
    ]
  },
  {
    "para_index": 3,
    "text": "Esto es exactamente lo que le pasó a un hombre italiano en 1",
    "from_sec": 47.357,
    "to_sec": 75.41499999999999,
    "cues": [
      {
        "fromSec": 47.36,
        "toSec": 49.44,
        "text": "Esto es exactamente lo que le pasó a un"
      },
      {
        "fromSec": 49.48,
        "toSec": 52.48,
        "text": "hombre italiano en 1984."
      },
      {
        "fromSec": 52.52,
        "toSec": 54.56,
        "text": "Lo vamos a llamar Silvano, porque así lo"
      },
      {
        "fromSec": 54.64,
        "toSec": 56.32,
        "text": "conoce la literatura médica."
      },
      {
        "fromSec": 56.64,
        "toSec": 59.6,
        "text": "Tenía 53 años, y durante semanas,"
      },
      {
        "fromSec": 59.72,
        "toSec": 61.68,
        "text": "simplemente dejó de poder dormir."
      },
      {
        "fromSec": 62.32,
        "toSec": 64.08,
        "text": "Los médicos pensaron que era estrés,"
      },
      {
        "fromSec": 64.2,
        "toSec": 65.52,
        "text": "ansiedad, depresión."
      },
      {
        "fromSec": 66.0,
        "toSec": 67.36,
        "text": "Le dieron pastillas para dormir."
      },
      {
        "fromSec": 67.84,
        "toSec": 68.96,
        "text": "No funcionó nada."
      },
      {
        "fromSec": 69.44,
        "toSec": 70.0,
        "text": "Nunca."
      },
      {
        "fromSec": 70.14,
        "toSec": 72.94,
        "text": "Ningún sedante, ninguna droga, nada"
      },
      {
        "fromSec": 73.06,
        "toSec": 75.41,
        "text": "lograba darle ni un minuto de sueño real."
      }
    ]
  },
  {
    "para_index": 4,
    "text": "Pero lo más inquietante no era que Silvano no pudiera dormir",
    "from_sec": 76.055,
    "to_sec": 101.973,
    "cues": [
      {
        "fromSec": 76.06,
        "toSec": 77.73,
        "text": "Pero lo más inquietante no era que"
      },
      {
        "fromSec": 77.86,
        "toSec": 79.25,
        "text": "Silvano no pudiera dormir."
      },
      {
        "fromSec": 79.89,
        "toSec": 82.05,
        "text": "Era que ya sabía exactamente lo que le"
      },
      {
        "fromSec": 82.17,
        "toSec": 82.61,
        "text": "esperaba."
      },
      {
        "fromSec": 83.49,
        "toSec": 86.05,
        "text": "Había visto morir a su padre, a sus tías,"
      },
      {
        "fromSec": 86.09,
        "toSec": 89.25,
        "text": "a su abuelo, todos de la misma forma: un"
      },
      {
        "fromSec": 89.37,
        "toSec": 91.89,
        "text": "día simplemente dejaban de dormir, y un"
      },
      {
        "fromSec": 91.97,
        "toSec": 94.29,
        "text": "año o dos después, estaban muertos."
      },
      {
        "fromSec": 95.01,
        "toSec": 97.65,
        "text": "En su familia lo llamaban, en voz baja,"
      },
      {
        "fromSec": 97.69,
        "toSec": 98.53,
        "text": "\"la maldición\"."
      },
      {
        "fromSec": 99.41,
        "toSec": 101.25,
        "text": "Nadie sabía todavía que tenía nombre"
      },
      {
        "fromSec": 101.37,
        "toSec": 101.97,
        "text": "científico."
      }
    ]
  },
  {
    "para_index": 5,
    "text": "Día tres sin dormir real. El cuerpo humano no está diseñado ",
    "from_sec": 103.253,
    "to_sec": 122.852,
    "cues": [
      {
        "fromSec": 103.25,
        "toSec": 105.17,
        "text": "Día tres sin dormir real."
      },
      {
        "fromSec": 106.05,
        "toSec": 108.05,
        "text": "El cuerpo humano no está diseñado para"
      },
      {
        "fromSec": 108.21,
        "toSec": 108.53,
        "text": "esto."
      },
      {
        "fromSec": 109.01,
        "toSec": 110.93,
        "text": "A estas alturas ya deberías sentir una"
      },
      {
        "fromSec": 111.01,
        "toSec": 113.49,
        "text": "fatiga insoportable, pero los pacientes"
      },
      {
        "fromSec": 113.57,
        "toSec": 115.41,
        "text": "con esta enfermedad describen algo más"
      },
      {
        "fromSec": 115.49,
        "toSec": 118.29,
        "text": "extraño: están exhaustos y, al mismo"
      },
      {
        "fromSec": 118.37,
        "toSec": 120.29,
        "text": "tiempo, completamente alerta."
      },
      {
        "fromSec": 120.85,
        "toSec": 122.85,
        "text": "El cerebro no logra apagarse."
      }
    ]
  },
  {
    "para_index": 6,
    "text": "Día siete. Empiezan los síntomas que no esperarías. No es so",
    "from_sec": 124.05199999999999,
    "to_sec": 150.79500000000002,
    "cues": [
      {
        "fromSec": 124.05,
        "toSec": 124.85,
        "text": "Día siete."
      },
      {
        "fromSec": 125.57,
        "toSec": 127.73,
        "text": "Empiezan los síntomas que no esperarías."
      },
      {
        "fromSec": 128.21,
        "toSec": 129.61,
        "text": "No es solo cansancio."
      },
      {
        "fromSec": 129.89,
        "toSec": 132.13,
        "text": "El cuerpo empieza a sudar sin razón."
      },
      {
        "fromSec": 132.61,
        "toSec": 134.61,
        "text": "La presión arterial sube y baja sin"
      },
      {
        "fromSec": 134.69,
        "toSec": 135.25,
        "text": "control."
      },
      {
        "fromSec": 135.65,
        "toSec": 137.25,
        "text": "Las pupilas se dilatan."
      },
      {
        "fromSec": 137.4,
        "toSec": 139.32,
        "text": "El corazón se acelera como si estuvieras"
      },
      {
        "fromSec": 139.4,
        "toSec": 142.65,
        "text": "corriendo, incluso acostado, en silencio,"
      },
      {
        "fromSec": 142.7,
        "toSec": 144.08,
        "text": "sin moverte."
      },
      {
        "fromSec": 144.12,
        "toSec": 146.04,
        "text": "Tu sistema nervioso autónomo, el que"
      },
      {
        "fromSec": 146.2,
        "toSec": 148.19,
        "text": "controla todo lo que no piensas,"
      },
      {
        "fromSec": 148.35,
        "toSec": 150.8,
        "text": "literalmente se está desmoronando."
      }
    ]
  },
  {
    "para_index": 7,
    "text": "Día quince. Aquí es donde se pone realmente perturbador. Emp",
    "from_sec": 150.835,
    "to_sec": 177.554,
    "cues": [
      {
        "fromSec": 150.84,
        "toSec": 152.24,
        "text": "Día quince."
      },
      {
        "fromSec": 152.28,
        "toSec": 154.12,
        "text": "Aquí es donde se pone realmente"
      },
      {
        "fromSec": 154.19,
        "toSec": 155.56,
        "text": "perturbador."
      },
      {
        "fromSec": 155.63,
        "toSec": 157.8,
        "text": "Empiezan las alucinaciones, pero no como"
      },
      {
        "fromSec": 157.88,
        "toSec": 159.37,
        "text": "las imaginas."
      },
      {
        "fromSec": 159.42,
        "toSec": 161.31,
        "text": "Los pacientes entran en un estado que los"
      },
      {
        "fromSec": 161.4,
        "toSec": 164.0,
        "text": "médicos llaman estupor onírico:"
      },
      {
        "fromSec": 164.03,
        "toSec": 166.43,
        "text": "literalmente actúan sus sueños estando"
      },
      {
        "fromSec": 166.55,
        "toSec": 167.67,
        "text": "despiertos."
      },
      {
        "fromSec": 167.71,
        "toSec": 170.19,
        "text": "Hacen gestos, hablan, repiten acciones"
      },
      {
        "fromSec": 170.27,
        "toSec": 172.43,
        "text": "cotidianas, como si estuvieran soñando"
      },
      {
        "fromSec": 172.51,
        "toSec": 174.99,
        "text": "con los ojos abiertos, atrapados entre"
      },
      {
        "fromSec": 175.07,
        "toSec": 177.55,
        "text": "dos mundos que ya no pueden separar."
      }
    ]
  },
  {
    "para_index": 8,
    "text": "Día treinta. El cuerpo empieza a consumirse a sí mismo. Pérd",
    "from_sec": 177.63400000000001,
    "to_sec": 200.872,
    "cues": [
      {
        "fromSec": 177.63,
        "toSec": 178.95,
        "text": "Día treinta."
      },
      {
        "fromSec": 178.99,
        "toSec": 180.99,
        "text": "El cuerpo empieza a consumirse a sí"
      },
      {
        "fromSec": 181.03,
        "toSec": 182.06,
        "text": "mismo."
      },
      {
        "fromSec": 182.09,
        "toSec": 183.47,
        "text": "Pérdida de peso rápida y"
      },
      {
        "fromSec": 183.95,
        "toSec": 184.47,
        "text": "visible."
      },
      {
        "fromSec": 184.51,
        "toSec": 186.15,
        "text": "Los músculos se debilitan."
      },
      {
        "fromSec": 186.19,
        "toSec": 187.93,
        "text": "La memoria falla."
      },
      {
        "fromSec": 187.98,
        "toSec": 189.47,
        "text": "Empiezan a aparecer los síntomas que"
      },
      {
        "fromSec": 189.59,
        "toSec": 191.77,
        "text": "parecen demencia: confusión,"
      },
      {
        "fromSec": 191.82,
        "toSec": 194.79,
        "text": "desorientación, cambios de personalidad."
      },
      {
        "fromSec": 194.83,
        "toSec": 197.55,
        "text": "Y todo esto, recuerda, sin haber dormido"
      },
      {
        "fromSec": 197.63,
        "toSec": 199.87,
        "text": "ni un segundo de sueño reparador en un"
      },
      {
        "fromSec": 200.35,
        "toSec": 200.87,
        "text": "mes."
      }
    ]
  },
  {
    "para_index": 9,
    "text": "¿Y qué está pasando realmente dentro del cerebro mientras to",
    "from_sec": 200.912,
    "to_sec": 205.432,
    "cues": [
      {
        "fromSec": 200.91,
        "toSec": 202.91,
        "text": "¿Y qué está pasando realmente dentro del"
      },
      {
        "fromSec": 202.99,
        "toSec": 205.43,
        "text": "cerebro mientras todo esto ocurre?"
      }
    ]
  },
  {
    "para_index": 10,
    "text": "La respuesta está en una región diminuta llamada tálamo. El ",
    "from_sec": 205.519,
    "to_sec": 224.358,
    "cues": [
      {
        "fromSec": 205.52,
        "toSec": 207.92,
        "text": "La respuesta está en una región diminuta"
      },
      {
        "fromSec": 208.0,
        "toSec": 209.68,
        "text": "llamada tálamo."
      },
      {
        "fromSec": 209.76,
        "toSec": 211.76,
        "text": "El tálamo es como la central de control"
      },
      {
        "fromSec": 211.84,
        "toSec": 214.48,
        "text": "del sueño: decide cuándo tu cerebro se"
      },
      {
        "fromSec": 214.56,
        "toSec": 216.16,
        "text": "desconecta del mundo exterior para"
      },
      {
        "fromSec": 216.28,
        "toSec": 217.63,
        "text": "descansar."
      },
      {
        "fromSec": 217.65,
        "toSec": 219.92,
        "text": "En el insomnio familiar fatal, el tálamo"
      },
      {
        "fromSec": 219.96,
        "toSec": 223.04,
        "text": "se está destruyendo, literalmente, célula"
      },
      {
        "fromSec": 223.16,
        "toSec": 224.36,
        "text": "por célula."
      }
    ]
  },
  {
    "para_index": 11,
    "text": "¿Y qué lo está destruyendo? No es un virus. No es una bacter",
    "from_sec": 224.398,
    "to_sec": 232.371,
    "cues": [
      {
        "fromSec": 224.4,
        "toSec": 226.2,
        "text": "¿Y qué lo está destruyendo?"
      },
      {
        "fromSec": 226.24,
        "toSec": 227.4,
        "text": "No es un virus."
      },
      {
        "fromSec": 227.44,
        "toSec": 228.84,
        "text": "No es una bacteria."
      },
      {
        "fromSec": 228.88,
        "toSec": 232.37,
        "text": "Es algo mucho más extraño: una proteína."
      }
    ]
  },
  {
    "para_index": 12,
    "text": "Se llama prión. Normalmente, esta proteína, llamada PrP, exi",
    "from_sec": 232.425,
    "to_sec": 266.356,
    "cues": [
      {
        "fromSec": 232.43,
        "toSec": 234.28,
        "text": "Se llama prión."
      },
      {
        "fromSec": 234.32,
        "toSec": 237.8,
        "text": "Normalmente, esta proteína, llamada PrP,"
      },
      {
        "fromSec": 237.84,
        "toSec": 239.84,
        "text": "existe en tu cerebro sin causar ningún"
      },
      {
        "fromSec": 239.92,
        "toSec": 241.0,
        "text": "problema."
      },
      {
        "fromSec": 241.04,
        "toSec": 242.96,
        "text": "Pero en estos pacientes, una mutación"
      },
      {
        "fromSec": 243.04,
        "toSec": 245.12,
        "text": "genética hace que la proteína se pliegue"
      },
      {
        "fromSec": 245.2,
        "toSec": 247.88,
        "text": "mal, que tome una forma incorrecta."
      },
      {
        "fromSec": 247.92,
        "toSec": 250.44,
        "text": "Y esa forma incorrecta es contagiosa,"
      },
      {
        "fromSec": 250.48,
        "toSec": 253.12,
        "text": "dentro del propio cerebro: cada proteína"
      },
      {
        "fromSec": 253.24,
        "toSec": 254.96,
        "text": "mal plegada obliga a las proteínas"
      },
      {
        "fromSec": 255.12,
        "toSec": 257.04,
        "text": "normales de alrededor a plegarse igual"
      },
      {
        "fromSec": 257.12,
        "toSec": 259.44,
        "text": "que ella, como una reacción en cadena que"
      },
      {
        "fromSec": 259.52,
        "toSec": 260.92,
        "text": "no se detiene."
      },
      {
        "fromSec": 260.96,
        "toSec": 263.28,
        "text": "El tálamo, literalmente, se va llenando"
      },
      {
        "fromSec": 263.32,
        "toSec": 265.04,
        "text": "de agujeros microscópicos, como una"
      },
      {
        "fromSec": 265.12,
        "toSec": 266.36,
        "text": "esponja."
      }
    ]
  },
  {
    "para_index": 13,
    "text": "Esta es la misma familia de enfermedades que la enfermedad d",
    "from_sec": 266.46,
    "to_sec": 299.938,
    "cues": [
      {
        "fromSec": 266.46,
        "toSec": 268.54,
        "text": "Esta es la misma familia de enfermedades"
      },
      {
        "fromSec": 268.58,
        "toSec": 270.54,
        "text": "que la enfermedad de las vacas locas, y"
      },
      {
        "fromSec": 270.58,
        "toSec": 272.94,
        "text": "la enfermedad de Creutzfeldt-Jakob."
      },
      {
        "fromSec": 272.98,
        "toSec": 275.9,
        "text": "Todas son enfermedades priónicas."
      },
      {
        "fromSec": 275.93,
        "toSec": 277.82,
        "text": "Pero el insomnio familiar fatal tiene"
      },
      {
        "fromSec": 277.9,
        "toSec": 281.3,
        "text": "algo que la hace única: es hereditaria."
      },
      {
        "fromSec": 281.34,
        "toSec": 283.42,
        "text": "Se transmite de padres a hijos con una"
      },
      {
        "fromSec": 283.5,
        "toSec": 286.06,
        "text": "probabilidad del cincuenta por ciento, y"
      },
      {
        "fromSec": 286.1,
        "toSec": 288.14,
        "text": "los científicos la rastrearon hasta una"
      },
      {
        "fromSec": 288.22,
        "toSec": 290.3,
        "text": "sola familia italiana, cuyo árbol"
      },
      {
        "fromSec": 290.42,
        "toSec": 292.54,
        "text": "genealógico documentado se remonta a un"
      },
      {
        "fromSec": 292.62,
        "toSec": 295.02,
        "text": "médico veneciano que murió exactamente"
      },
      {
        "fromSec": 295.1,
        "toSec": 297.5,
        "text": "con estos mismos síntomas, en el año mil"
      },
      {
        "fromSec": 297.58,
        "toSec": 299.94,
        "text": "setecientos sesenta y cinco."
      }
    ]
  },
  {
    "para_index": 14,
    "text": "El médico que finalmente le puso nombre a la enfermedad de S",
    "from_sec": 299.978,
    "to_sec": 335.875,
    "cues": [
      {
        "fromSec": 299.98,
        "toSec": 301.9,
        "text": "El médico que finalmente le puso nombre a"
      },
      {
        "fromSec": 301.94,
        "toSec": 304.22,
        "text": "la enfermedad de Silvano se llamaba Elio"
      },
      {
        "fromSec": 304.3,
        "toSec": 308.48,
        "text": "Lugaresi, en Bolonia, en 1986."
      },
      {
        "fromSec": 308.5,
        "toSec": 310.54,
        "text": "Pero el verdadero avance llegó seis años"
      },
      {
        "fromSec": 310.62,
        "toSec": 314.3,
        "text": "después, en 1992, cuando el investigador"
      },
      {
        "fromSec": 314.34,
        "toSec": 316.78,
        "text": "Pierluigi Gambetti consiguió identificar"
      },
      {
        "fromSec": 316.82,
        "toSec": 320.46,
        "text": "la mutación exacta: un solo cambio, en un"
      },
      {
        "fromSec": 320.5,
        "toSec": 322.54,
        "text": "solo punto, del gen que produce la"
      },
      {
        "fromSec": 322.62,
        "toSec": 324.94,
        "text": "proteína PrP."
      },
      {
        "fromSec": 325.07,
        "toSec": 327.07,
        "text": "Una letra equivocada, en un código"
      },
      {
        "fromSec": 327.15,
        "toSec": 329.63,
        "text": "genético de miles de millones de letras,"
      },
      {
        "fromSec": 329.68,
        "toSec": 331.88,
        "text": "y el resultado es una sentencia de muerte"
      },
      {
        "fromSec": 331.95,
        "toSec": 334.19,
        "text": "programada que puede tardar generaciones"
      },
      {
        "fromSec": 334.24,
        "toSec": 335.88,
        "text": "en activarse."
      }
    ]
  },
  {
    "para_index": 15,
    "text": "Y hay algo todavía más extraño: existe una versión de esta e",
    "from_sec": 335.915,
    "to_sec": 359.873,
    "cues": [
      {
        "fromSec": 335.92,
        "toSec": 338.6,
        "text": "Y hay algo todavía más extraño: existe"
      },
      {
        "fromSec": 338.68,
        "toSec": 340.19,
        "text": "una versión de esta enfermedad en"
      },
      {
        "fromSec": 340.27,
        "toSec": 342.75,
        "text": "personas sin ningún antecedente familiar,"
      },
      {
        "fromSec": 342.83,
        "toSec": 345.07,
        "text": "sin ninguna mutación heredada."
      },
      {
        "fromSec": 345.15,
        "toSec": 348.09,
        "text": "Se llama insomnio fatal esporádico, y"
      },
      {
        "fromSec": 348.14,
        "toSec": 350.27,
        "text": "aparece de la nada, al azar,"
      },
      {
        "fromSec": 350.35,
        "toSec": 352.03,
        "text": "probablemente por una proteína que se"
      },
      {
        "fromSec": 352.07,
        "toSec": 354.46,
        "text": "pliega mal por pura casualidad."
      },
      {
        "fromSec": 354.49,
        "toSec": 356.31,
        "text": "Es todavía más rara."
      },
      {
        "fromSec": 356.35,
        "toSec": 359.87,
        "text": "Pero el final es exactamente el mismo."
      }
    ]
  },
  {
    "para_index": 16,
    "text": "Día cuarenta y cinco. Para esta altura, dormir ya no es solo",
    "from_sec": 359.913,
    "to_sec": 378.939,
    "cues": [
      {
        "fromSec": 359.91,
        "toSec": 362.03,
        "text": "Día cuarenta y cinco."
      },
      {
        "fromSec": 362.11,
        "toSec": 364.03,
        "text": "Para esta altura, dormir ya no es solo"
      },
      {
        "fromSec": 364.11,
        "toSec": 366.51,
        "text": "imposible: es como si la palabra hubiera"
      },
      {
        "fromSec": 366.59,
        "toSec": 368.73,
        "text": "perdido su significado."
      },
      {
        "fromSec": 368.78,
        "toSec": 370.67,
        "text": "Los pacientes dejan de poder diferenciar"
      },
      {
        "fromSec": 370.75,
        "toSec": 373.27,
        "text": "entre estar despiertos y soñar."
      },
      {
        "fromSec": 373.31,
        "toSec": 375.75,
        "text": "Viven en una especie de niebla constante,"
      },
      {
        "fromSec": 375.79,
        "toSec": 377.47,
        "text": "entre dos realidades que ya no pueden"
      },
      {
        "fromSec": 377.55,
        "toSec": 378.94,
        "text": "separar."
      }
    ]
  },
  {
    "para_index": 17,
    "text": "Y aquí viene la parte más cruel de todas. Los médicos, duran",
    "from_sec": 378.965,
    "to_sec": 416.015,
    "cues": [
      {
        "fromSec": 378.96,
        "toSec": 382.08,
        "text": "Y aquí viene la parte más cruel de todas."
      },
      {
        "fromSec": 382.14,
        "toSec": 384.59,
        "text": "Los médicos, durante años, pensaron que"
      },
      {
        "fromSec": 384.67,
        "toSec": 386.91,
        "text": "lo lógico sería intentar inducir el sueño"
      },
      {
        "fromSec": 386.99,
        "toSec": 389.58,
        "text": "con sedantes más y más fuertes."
      },
      {
        "fromSec": 389.61,
        "toSec": 390.99,
        "text": "Lo intentaron."
      },
      {
        "fromSec": 391.06,
        "toSec": 393.46,
        "text": "Con un paciente, probaron incluso coma"
      },
      {
        "fromSec": 393.54,
        "toSec": 395.94,
        "text": "inducido por barbitúricos, pensando que"
      },
      {
        "fromSec": 396.02,
        "toSec": 398.82,
        "text": "quizás así el cerebro podría, de alguna"
      },
      {
        "fromSec": 398.9,
        "toSec": 400.1,
        "text": "forma, descansar."
      },
      {
        "fromSec": 400.9,
        "toSec": 401.62,
        "text": "No funcionó."
      },
      {
        "fromSec": 402.34,
        "toSec": 404.26,
        "text": "Las ondas cerebrales durante ese coma"
      },
      {
        "fromSec": 404.34,
        "toSec": 406.02,
        "text": "seguían mostrando el mismo patrón"
      },
      {
        "fromSec": 406.18,
        "toSec": 406.66,
        "text": "alterado."
      },
      {
        "fromSec": 407.38,
        "toSec": 409.3,
        "text": "El problema no era que el paciente no"
      },
      {
        "fromSec": 409.38,
        "toSec": 410.5,
        "text": "pudiera relajarse."
      },
      {
        "fromSec": 410.98,
        "toSec": 413.22,
        "text": "El problema era que la estructura física"
      },
      {
        "fromSec": 413.3,
        "toSec": 416.01,
        "text": "que genera el sueño ya no existía."
      }
    ]
  },
  {
    "para_index": 18,
    "text": "Día sesenta. Los pacientes entran en lo que los médicos llam",
    "from_sec": 416.655,
    "to_sec": 432.054,
    "cues": [
      {
        "fromSec": 416.65,
        "toSec": 417.62,
        "text": "Día sesenta."
      },
      {
        "fromSec": 418.5,
        "toSec": 419.94,
        "text": "Los pacientes entran en lo que los"
      },
      {
        "fromSec": 420.01,
        "toSec": 422.01,
        "text": "médicos llaman un estado vegetativo"
      },
      {
        "fromSec": 422.1,
        "toSec": 424.25,
        "text": "progresivo, con episodios de pánico"
      },
      {
        "fromSec": 424.38,
        "toSec": 426.65,
        "text": "extremo, porque incluso en ese estado de"
      },
      {
        "fromSec": 426.74,
        "toSec": 429.37,
        "text": "agotamiento total, una parte del cerebro"
      },
      {
        "fromSec": 429.45,
        "toSec": 432.05,
        "text": "permanece dolorosamente consciente."
      }
    ]
  },
  {
    "para_index": 19,
    "text": "Día noventa. Silvano ya casi no podía hablar con claridad. P",
    "from_sec": 432.574,
    "to_sec": 459.594,
    "cues": [
      {
        "fromSec": 432.57,
        "toSec": 433.45,
        "text": "Día noventa."
      },
      {
        "fromSec": 434.33,
        "toSec": 436.33,
        "text": "Silvano ya casi no podía hablar con"
      },
      {
        "fromSec": 436.41,
        "toSec": 437.17,
        "text": "claridad."
      },
      {
        "fromSec": 437.45,
        "toSec": 439.45,
        "text": "Pasaba la mayor parte del tiempo en ese"
      },
      {
        "fromSec": 439.53,
        "toSec": 441.61,
        "text": "límite borroso entre el sueño y la"
      },
      {
        "fromSec": 441.73,
        "toSec": 444.45,
        "text": "vigilia, incapaz de reconocer del todo a"
      },
      {
        "fromSec": 444.49,
        "toSec": 445.61,
        "text": "su propia familia."
      },
      {
        "fromSec": 445.75,
        "toSec": 447.27,
        "text": "Los médicos que lo estudiaban"
      },
      {
        "fromSec": 447.39,
        "toSec": 449.99,
        "text": "describieron algo desgarrador: en sus"
      },
      {
        "fromSec": 450.07,
        "toSec": 452.31,
        "text": "pocos momentos de lucidez, él sabía"
      },
      {
        "fromSec": 452.59,
        "toSec": 454.79,
        "text": "exactamente lo que le estaba pasando,"
      },
      {
        "fromSec": 454.87,
        "toSec": 456.95,
        "text": "porque lo había visto pasarle a cada uno"
      },
      {
        "fromSec": 456.99,
        "toSec": 459.59,
        "text": "de sus familiares antes que a él."
      }
    ]
  },
  {
    "para_index": 20,
    "text": "Día ciento veinte. El cuerpo, después de meses sin descanso ",
    "from_sec": 459.674,
    "to_sec": 482.832,
    "cues": [
      {
        "fromSec": 459.67,
        "toSec": 461.67,
        "text": "Día ciento veinte."
      },
      {
        "fromSec": 461.75,
        "toSec": 464.07,
        "text": "El cuerpo, después de meses sin descanso"
      },
      {
        "fromSec": 464.39,
        "toSec": 466.23,
        "text": "real, simplemente ya no tiene más"
      },
      {
        "fromSec": 466.31,
        "toSec": 467.62,
        "text": "reservas."
      },
      {
        "fromSec": 467.65,
        "toSec": 469.73,
        "text": "El sistema inmune se debilita."
      },
      {
        "fromSec": 469.79,
        "toSec": 471.51,
        "text": "Cualquier infección menor se vuelve"
      },
      {
        "fromSec": 471.63,
        "toSec": 473.79,
        "text": "potencialmente mortal."
      },
      {
        "fromSec": 473.83,
        "toSec": 476.07,
        "text": "Y es generalmente así, no el insomnio en"
      },
      {
        "fromSec": 476.11,
        "toSec": 478.39,
        "text": "sí mismo, sino el colapso en cadena de"
      },
      {
        "fromSec": 478.47,
        "toSec": 480.71,
        "text": "todo el cuerpo, lo que finalmente termina"
      },
      {
        "fromSec": 480.75,
        "toSec": 482.83,
        "text": "con la vida del paciente."
      }
    ]
  },
  {
    "para_index": 21,
    "text": "Y la pregunta que probablemente te estás haciendo: ¿por qué ",
    "from_sec": 482.872,
    "to_sec": 520.3,
    "cues": [
      {
        "fromSec": 482.87,
        "toSec": 484.55,
        "text": "Y la pregunta que probablemente te estás"
      },
      {
        "fromSec": 484.63,
        "toSec": 486.71,
        "text": "haciendo: ¿por qué nadie puede"
      },
      {
        "fromSec": 486.83,
        "toSec": 488.79,
        "text": "simplemente curarlo?"
      },
      {
        "fromSec": 488.87,
        "toSec": 490.55,
        "text": "La respuesta es aterradora en su"
      },
      {
        "fromSec": 490.63,
        "toSec": 491.87,
        "text": "simpleza."
      },
      {
        "fromSec": 491.91,
        "toSec": 494.76,
        "text": "Los priones no son organismos vivos."
      },
      {
        "fromSec": 494.82,
        "toSec": 496.68,
        "text": "No puedes matarlos con antibióticos,"
      },
      {
        "fromSec": 496.74,
        "toSec": 499.08,
        "text": "porque no hay nada vivo que matar."
      },
      {
        "fromSec": 499.14,
        "toSec": 500.47,
        "text": "No puedes atacarlos con el sistema"
      },
      {
        "fromSec": 500.55,
        "toSec": 502.63,
        "text": "inmune, porque tu cuerpo ni siquiera los"
      },
      {
        "fromSec": 502.71,
        "toSec": 505.03,
        "text": "reconoce como una amenaza: tienen la"
      },
      {
        "fromSec": 505.15,
        "toSec": 507.03,
        "text": "misma composición química que tus propias"
      },
      {
        "fromSec": 507.11,
        "toSec": 508.87,
        "text": "proteínas normales."
      },
      {
        "fromSec": 508.94,
        "toSec": 511.82,
        "text": "Y son casi indestructibles: sobreviven al"
      },
      {
        "fromSec": 511.9,
        "toSec": 513.98,
        "text": "calor, a los químicos que destruirían"
      },
      {
        "fromSec": 514.06,
        "toSec": 516.66,
        "text": "cualquier virus o bacteria, incluso a la"
      },
      {
        "fromSec": 516.7,
        "toSec": 518.58,
        "text": "esterilización estándar de instrumentos"
      },
      {
        "fromSec": 518.62,
        "toSec": 520.3,
        "text": "quirúrgicos."
      }
    ]
  },
  {
    "para_index": 22,
    "text": "Actualmente existen científicos investigando terapias genéti",
    "from_sec": 520.5,
    "to_sec": 541.659,
    "cues": [
      {
        "fromSec": 520.5,
        "toSec": 522.14,
        "text": "Actualmente existen científicos"
      },
      {
        "fromSec": 522.22,
        "toSec": 523.74,
        "text": "investigando terapias genéticas"
      },
      {
        "fromSec": 524.06,
        "toSec": 526.14,
        "text": "experimentales, como el uso de CRISPR"
      },
      {
        "fromSec": 526.22,
        "toSec": 528.14,
        "text": "para silenciar directamente el gen que"
      },
      {
        "fromSec": 528.3,
        "toSec": 530.46,
        "text": "produce la proteína defectuosa, antes de"
      },
      {
        "fromSec": 530.5,
        "toSec": 532.54,
        "text": "que empiece a plegarse mal."
      },
      {
        "fromSec": 532.62,
        "toSec": 534.46,
        "text": "Hay ensayos tempranos con fármacos como"
      },
      {
        "fromSec": 534.54,
        "toSec": 536.78,
        "text": "la doxiciclina, que podrían ralentizar el"
      },
      {
        "fromSec": 536.86,
        "toSec": 538.06,
        "text": "proceso."
      },
      {
        "fromSec": 538.11,
        "toSec": 540.38,
        "text": "Pero hasta hoy, no existe ninguna cura"
      },
      {
        "fromSec": 540.46,
        "toSec": 541.66,
        "text": "confirmada."
      }
    ]
  },
  {
    "para_index": 23,
    "text": "La enfermedad, en promedio, mata entre los siete y los trein",
    "from_sec": 542.219,
    "to_sec": 561.498,
    "cues": [
      {
        "fromSec": 542.22,
        "toSec": 544.46,
        "text": "La enfermedad, en promedio, mata entre"
      },
      {
        "fromSec": 544.54,
        "toSec": 546.38,
        "text": "los siete y los treinta y seis meses"
      },
      {
        "fromSec": 546.46,
        "toSec": 549.1,
        "text": "después de que aparece el primer síntoma."
      },
      {
        "fromSec": 549.14,
        "toSec": 551.02,
        "text": "La causa de muerte final no suele ser"
      },
      {
        "fromSec": 551.14,
        "toSec": 553.26,
        "text": "directamente la falta de sueño: es el"
      },
      {
        "fromSec": 553.34,
        "toSec": 555.18,
        "text": "colapso total del sistema nervioso"
      },
      {
        "fromSec": 555.3,
        "toSec": 558.46,
        "text": "autónomo, el mismo sistema que, recuerda,"
      },
      {
        "fromSec": 558.54,
        "toSec": 561.5,
        "text": "empezó a fallar allá por el día siete."
      }
    ]
  },
  {
    "para_index": 24,
    "text": "Es una de las enfermedades más raras del mundo. Se estima qu",
    "from_sec": 561.578,
    "to_sec": 586.4,
    "cues": [
      {
        "fromSec": 561.58,
        "toSec": 563.5,
        "text": "Es una de las enfermedades más raras del"
      },
      {
        "fromSec": 563.58,
        "toSec": 564.46,
        "text": "mundo."
      },
      {
        "fromSec": 564.5,
        "toSec": 566.14,
        "text": "Se estima que existen menos de cien"
      },
      {
        "fromSec": 566.18,
        "toSec": 568.38,
        "text": "familias conocidas en todo el planeta que"
      },
      {
        "fromSec": 568.5,
        "toSec": 570.38,
        "text": "portan esta mutación."
      },
      {
        "fromSec": 570.48,
        "toSec": 572.56,
        "text": "Pero para cada una de esas familias,"
      },
      {
        "fromSec": 572.68,
        "toSec": 575.52,
        "text": "significa algo devastador: saber,"
      },
      {
        "fromSec": 575.64,
        "toSec": 578.56,
        "text": "generación tras generación, que dormir,"
      },
      {
        "fromSec": 578.6,
        "toSec": 580.16,
        "text": "lo que para el resto de nosotros es lo"
      },
      {
        "fromSec": 580.24,
        "toSec": 582.96,
        "text": "más natural del mundo, para ellos puede"
      },
      {
        "fromSec": 583.04,
        "toSec": 585.84,
        "text": "ser algo que un día, simplemente, deje de"
      },
      {
        "fromSec": 586.0,
        "toSec": 586.4,
        "text": "existir."
      }
    ]
  },
  {
    "para_index": 25,
    "text": "Así que la próxima vez que te cueste dormir, que te des vuel",
    "from_sec": 587.36,
    "to_sec": 600.4,
    "cues": [
      {
        "fromSec": 587.36,
        "toSec": 588.96,
        "text": "Así que la próxima vez que te cueste"
      },
      {
        "fromSec": 589.04,
        "toSec": 591.36,
        "text": "dormir, que te des vueltas en la cama,"
      },
      {
        "fromSec": 591.4,
        "toSec": 592.72,
        "text": "que mires el techo a las tres de la"
      },
      {
        "fromSec": 592.76,
        "toSec": 596.08,
        "text": "madrugada, recuerda esto: en algún lugar"
      },
      {
        "fromSec": 596.16,
        "toSec": 598.24,
        "text": "del mundo, hay personas para las que esa"
      },
      {
        "fromSec": 598.32,
        "toSec": 600.4,
        "text": "noche sin dormir nunca termina."
      }
    ]
  },
  {
    "para_index": 26,
    "text": "Y tú, ¿podrías vivir sabiendo que un día tu propio cerebro p",
    "from_sec": 601.359,
    "to_sec": 620.878,
    "cues": [
      {
        "fromSec": 601.36,
        "toSec": 604.0,
        "text": "Y tú, ¿podrías vivir sabiendo que un día"
      },
      {
        "fromSec": 604.24,
        "toSec": 606.08,
        "text": "tu propio cerebro podría dejar de"
      },
      {
        "fromSec": 606.16,
        "toSec": 608.96,
        "text": "permitirte descansar, para siempre?"
      },
      {
        "fromSec": 609.44,
        "toSec": 610.64,
        "text": "Cuéntame en los comentarios."
      },
      {
        "fromSec": 611.2,
        "toSec": 613.12,
        "text": "Y si quieres descubrir qué otros secretos"
      },
      {
        "fromSec": 613.2,
        "toSec": 615.92,
        "text": "esconde tu propio cuerpo, suscríbete,"
      },
      {
        "fromSec": 616.0,
        "toSec": 618.48,
        "text": "porque la próxima pregunta es: ¿y si tu"
      },
      {
        "fromSec": 618.52,
        "toSec": 620.88,
        "text": "cuerpo pudiera matarte mientras duermes?"
      }
    ]
  }
]